<UserControl x:Class="InventoryManagement.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

<Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>


         <!-- Left Login Card -->
        <Border Grid.Column="0"
             Background="{StaticResource PrimaryBrush}">

            <StackPanel VerticalAlignment="Center"
                        Margin="60">

                <materialDesign:PackIcon
                    Kind="Warehouse"
                    Width="90"
                    Height="90"
                    Foreground="White"/>

                <TextBlock
                    Margin="0,25,0,0"
                    Text="Inventory Management System"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Margin="0,15,0,35"
                    Text="Manage Products, Customers, Invoices and Reports"
                    FontSize="18"
                    Foreground="White"/>

                <TextBlock
                    Text="✓ Product Tracking"
                    FontSize="18"
                    Foreground="White"
                    Margin="0,10"/>

                <TextBlock
                    Text="✓ Customer Management"
                    FontSize="18"
                    Foreground="White"
                    Margin="0,10"/>

                <TextBlock
                    Text="✓ Invoice Generation"
                    FontSize="18"
                    Foreground="White"
                    Margin="0,10"/>

                <TextBlock
                    Text="✓ Revenue Analytics"
                    FontSize="18"
                    Foreground="White"
                    Margin="0,10"/>

                <TextBlock
                    Margin="0,40,0,0"
                    Text="Version 1.0"
                    FontSize="14"
                    Foreground="#DDE7FF"/>

            </StackPanel>
        </Border>

        <!-- Right Login Card -->

        <Grid Grid.Column="1">

            <Border Width="420"
                Height="450"
                Background="White"
                CornerRadius="15"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <StackPanel Margin="30">

                    <TextBlock
                        Text="Welcome Back"
                        FontSize="28"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Sign in to continue"
                        FontSize="14"
                        Foreground="Gray"
                        Margin="0,5,0,25"/>

                    <TextBlock Text="Email"/>

                    <TextBox
                        Height="45"
                        Margin="0,5,0,20"
                        Padding="10"
                        FontSize="14"
                        Text="{Binding Email,
                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Password"/>

                    <TextBox
                        Height="45"
                        Margin="0,5,0,25"
                        Padding="10"
                        FontSize="14"
                        Text="{Binding Password,
                              UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Height="50"
                        Content="SIGN IN"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#2563EB"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}" />

                    <TextBlock
                        Margin="0,20,0,0"
                        TextAlignment="Center"
                        Foreground="Gray"
                        FontSize="12"
                        Text="Inventory Management System © 2026"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>